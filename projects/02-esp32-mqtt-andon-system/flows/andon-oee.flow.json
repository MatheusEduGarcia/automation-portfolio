  {
    "type": "function",
    "name": "virtual ESP32 machine",
    "func": "// Virtual machine with the same topics, counters and OEE math as\n// firmware/esp32_machine_control. Ticks once per second.\nif (env.get(\"SIMULATE_DEVICE\") !== \"true\") return null;\nconst B = \"lab/line1/m2\";\nconst IDEAL_CYCLE_S = 10;\nconst now = Date.now();\nlet m = flow.get(\"vm\");\nif (!m || msg.topic === B + \"/cmd/reset\") {\n    const running = m ? m.running : false;\n    m = { running, cycles: 0, defects: 0, runtimeMs: 0, shiftStart: now, last: now,\n          nextToggle: now + 15000, partTimer: 0, defectLedUntil: 0 };\n}\nconst out = [];\nconst dt = now - m.last; m.last = now;\n\nif (now >= m.nextToggle) {                       // run ~60 s, stop ~15 s\n    m.running = !m.running;\n    m.nextToggle = now + (m.running ? 45000 + Math.random() * 30000 : 10000 + Math.random() * 10000);\n    out.push({ topic: B + \"/led/start\", payload: m.running ? \"1\" : \"0\", retain: true });\n    out.push({ topic: B + \"/led/stop\",  payload: m.running ? \"0\" : \"1\", retain: true });\n}\nif (m.running) {\n    m.runtimeMs += dt;\n    m.partTimer += dt;\n    const cycleMs = IDEAL_CYCLE_S * 1000 * (1.1 + Math.random() * 0.3);   // a bit slower than ideal\n    if (m.partTimer >= cycleMs) {\n        m.partTimer = 0;\n        m.cycles += 1;\n        if (Math.random() < 0.05 && m.defects < m.cycles) {\n            m.defects += 1;\n            m.defectLedUntil = now + 3000;\n            out.push({ topic: B + \"/led/defect\", payload: \"1\", retain: true });\n        }\n    }\n}\nif (m.defectLedUntil && now > m.defectLedUntil) {\n    m.defectLedUntil = 0;\n    out.push({ topic: B + \"/led/defect\", payload: \"0\", retain: true });\n}\nflow.set(\"vm\", m);\n\nconst runtime = Math.floor(m.runtimeMs / 1000);\nconst planned = Math.floor((now - m.shiftStart) / 1000);\nconst A = planned > 0 ? Math.min(runtime / planned, 1) : 0;\nconst P = runtime > 0 ? Math.min(m.cycles * IDEAL_CYCLE_S / runtime, 1) : 0;\nconst Q = m.cycles > 0 ? (m.cycles - m.defects) / m.cycles : 1;\nconst r1 = x => Math.round(x * 1000) / 10;\nout.push({ topic: B + \"/status\", payload: \"online\", retain: true });\nout.push({ topic: B + \"/metrics\", retain: true, payload: JSON.stringify({\n    running: m.running, cycles: m.cycles, defects: m.defects, runtime, planned,\n    availability: r1(A), performance: r1(P), quality: r1(Q), oee: r1(A * P * Q) }) });\nreturn [out];",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
