  {
    "type": "ui_template",
    "group": "grp_02_tower",
    "name": "Andon tower",
    "order": 1,
    "width": 6,
    "height": 9,
    "format": "<div class=\"andon\">\n  <div class=\"tower\">\n    <div class=\"lamp red\"    ng-class=\"{on: msg.payload.state === 'red'}\"></div>\n    <div class=\"lamp yellow\" ng-class=\"{on: msg.payload.state === 'yellow'}\"></div>\n    <div class=\"lamp green\"  ng-class=\"{on: msg.payload.state === 'green'}\"></div>\n    <div class=\"pole\"></div>\n    <div class=\"base\"></div>\n  </div>\n  <div class=\"label\" ng-class=\"msg.payload.state\">{{msg.payload.text || 'WAITING FOR DATA'}}</div>\n</div>\n<style>\n.andon { text-align: center; padding: 8px 0; }\n.andon .tower { display: inline-block; padding: 12px 14px 0; background: #1b1b1b; border-radius: 14px; }\n.andon .lamp { width: 96px; height: 96px; border-radius: 50%; margin: 8px auto; background: #2d2d2d;\n               border: 4px solid #111; transition: all .3s ease; }\n.andon .lamp.red.on    { background: radial-gradient(circle, #ff3b30, #a40000); box-shadow: 0 0 36px #ff3b30; animation: pulse 1s infinite; }\n.andon .lamp.yellow.on { background: radial-gradient(circle, #ffe600, #c7a800); box-shadow: 0 0 36px #ffe600; animation: pulse 1s infinite; }\n.andon .lamp.green.on  { background: radial-gradient(circle, #34c759, #0b7a2a); box-shadow: 0 0 36px #34c759; }\n.andon .pole { width: 26px; height: 46px; margin: 0 auto; background: linear-gradient(to right, #444, #222); }\n.andon .base { width: 96px; height: 16px; margin: 0 auto; background: #111; border-radius: 8px; }\n.andon .label { margin-top: 14px; font-size: 20px; font-weight: 600; letter-spacing: .5px; color: #888; }\n.andon .label.red { color: #ff3b30; } .andon .label.yellow { color: #ffcc00; } .andon .label.green { color: #34c759; }\n@keyframes pulse { 0%,100% { opacity: 1; } 50% { opacity: .55; } }\n</style>\n",
    "storeOutMessages": true,
    "fwdInMessages": false,
    "resendOnRefresh": true,
    "templateScope": "local",
    "className": "",
    "id": "n0041",
    "z": "tab_02",
    "x": 880,
    "y": 120,
    "wires": []
  },
  {
    "type": "function",
    "name": "Andon logic",
    "func": "// Andon colour, highest priority first:\n//   grey   = device offline (LWT)\n//   yellow = defect LED on (problem)\n//   green  = machine running\n//   red    = machine stopped\nconst ctx = context.get(\"s\") || { online: false, running: false, defect: false };\nconst t = msg.topic;\nif (t.endsWith(\"/status\"))           ctx.online  = msg.payload === \"online\";\nelse if (t.endsWith(\"/metrics\"))     ctx.running = !!msg.payload.running;\nelse if (t.endsWith(\"/led/defect\"))  ctx.defect  = String(msg.payload) === \"1\";\nelse return null;\ncontext.set(\"s\", ctx);\n\nlet state, text;\nif (!ctx.online)       { state = \"off\";    text = \"DEVICE OFFLINE\"; }\nelse if (ctx.defect)   { state = \"yellow\"; text = \"PROBLEM: DEFECT\"; }\nelse if (ctx.running)  { state = \"green\";  text = \"PRODUCTION NORMAL\"; }\nelse                   { state = \"red\";    text = \"PRODUCTION STOPPED\"; }\nreturn { payload: { state, text } };",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "wires": [
      [
        "n0041"
      ]
    ],
    "id": "n0042",
    "z": "tab_02",
    "x": 620,
    "y": 120
