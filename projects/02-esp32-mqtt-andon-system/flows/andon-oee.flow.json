    "func": "// metrics JSON -> one message per widget\nconst m = msg.payload;\nconst hms = s => new Date(s * 1000).toISOString().substring(11, 19);\nreturn [\n    { payload: m.oee }, { payload: m.availability }, { payload: m.performance }, { payload: m.quality },\n    { payload: m.cycles }, { payload: m.defects }, { payload: hms(m.runtime) }, { payload: hms(m.planned) }\n];",
