  {
    "type": "function",
    "name": "Machine simulator",
    "func": "// Simple machine model: RUN / STOP / FAULT with cycle counter and speed.\n// Outputs: 1) state  2) cycle_count  3) speed  4) ts\nconst base = \"lab/line1/m1/telemetry/\";\nlet st = flow.get(\"sim\") || { state: \"STOP\", cycle: 0, speed: 0, lastChange: Date.now() };\nconst now = Date.now();\n\nif (msg.topic === \"force_state\" && typeof msg.payload === \"string\") {\n    st.state = msg.payload.toUpperCase();\n    st.lastChange = now;\n} else {\n    const dt = now - st.lastChange;\n    if (st.state !== \"FAULT\" && Math.random() > 0.995) { st.state = \"FAULT\"; st.lastChange = now; }\n    else if (st.state === \"FAULT\" && dt > 10000)        { st.state = \"STOP\";  st.lastChange = now; }\n    else if (st.state !== \"FAULT\" && dt > 20000)        { st.state = st.state === \"RUN\" ? \"STOP\" : \"RUN\"; st.lastChange = now; }\n}\n\nif (st.state === \"RUN\") {\n    st.cycle += 1;\n    st.speed = Math.round((50 + Math.random() * 20) * 10) / 10;\n} else {\n    st.speed = 0;\n}\nflow.set(\"sim\", st);\n\nreturn [\n    { topic: base + \"state\",       payload: st.state },\n    { topic: base + \"cycle_count\", payload: st.cycle },\n    { topic: base + \"speed\",       payload: st.speed },\n    { topic: base + \"ts\",          payload: new Date().toISOString() }\n];",
    "outputs": 4,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "wires": [
      [
        "n0002",
        "n0003"
      ],
      [
        "n0002",
        "n0004"
      ],
      [
        "n0002",
        "n0005"
      ],
      [
        "n0002"
      ]
    ],
    "id": "n0006",
    "z": "tab_01",
    "x": 500,
    "y": 160
  },
