  {
    "type": "function",
    "name": "virtual ESP32",
    "func": "// Behaves like firmware/esp32_mqtt_io: applies io/out/<n>/set and\n// confirms the new state on io/out/<n> (retained).\nif (env.get(\"SIMULATE_DEVICE\") !== \"true\") return null;\nif (msg.topic === \"boot\") {\n    return { topic: \"lab/line1/m1/io/status\", payload: \"online\" };\n}\nconst parts = msg.topic.split(\"/\");          // lab/line1/m1/io/out/<n>/set\nconst n = parseInt(parts[parts.length - 2], 10);\nconst v = String(msg.payload).trim().toLowerCase();\nconst on = (v === \"1\" || v === \"true\" || v === \"on\") ? \"1\" : (v === \"0\" || v === \"false\" || v === \"off\") ? \"0\" : null;\nif (isNaN(n) || on === null) return null;\nreturn { topic: \"lab/line1/m1/io/out/\" + n, payload: on };",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
