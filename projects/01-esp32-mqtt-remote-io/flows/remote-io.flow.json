    "type": "function",
    "name": "route state to switch",
    "func": "// io/out/<n> -> output n of this node, feeds the matching switch\nconst n = parseInt(msg.topic.split('/').pop(), 10);\nif (isNaN(n) || n < 0 || n > 7) return null;\nconst out = new Array(8).fill(null);\nout[n] = { payload: String(msg.payload) };\nreturn out;",
